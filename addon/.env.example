ADDON_NAME=VidSpark
# 1 = also append this addon's own /proxy URL as a second (non-direct) stream
INCLUDE_PROXY_FALLBACK=0
# 0 = /proxy returns 403 and no proxy URLs are emitted: video bytes never
# flow through this server (only tiny JSON resolve calls do)
PROXY_ENABLED=1
# Normalize all proxied audio toward one loudness so every title plays at
# the same level (single-pass live mode, no pre-measure). 0 = off.
AUDIO_TARGET_LUFS=-24
# Fixed gain fallback (dB) when normalization above is 0. Needs ffmpeg in PATH.
AUDIO_BOOST_DB=0
# comma-separated host suffixes the /proxy endpoint will fetch
PROXY_ALLOW=netrocdn.site,workers.dev,vidspark.to,site
